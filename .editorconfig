root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{sh,py,yml,yaml,json}]
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.java]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.ps1]
# Windows PowerShell 5.1 reads a file without a BOM as the ANSI code page.
charset = utf-8-bom
